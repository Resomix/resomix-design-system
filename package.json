{
  "name": "@resomix/design-system",
  "version": "0.2.0",
  "private": true,
  "description": "Resomix design system v3 (calm): tokens in two themes, type styles, aliases for the names the app uses today, and contrast checks.",
  "type": "module",
  "files": [
    "tokens",
    "docs",
    "assets"
  ],
  "exports": {
    "./resomix.css": "./tokens/resomix.css",
    "./pixels.css": "./tokens/pixels.css",
    "./tokens.json": "./tokens/v3/tokens.json",
    "./compat.json": "./tokens/compat.json",
    "./legacy/rx.css": "./tokens/legacy/rx.css"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/overview.mjs",
    "check": "node scripts/check-contrast.mjs",
    "test": "npm run build && npm run check && git diff --exit-code tokens/ docs/ README.md",
    "capture": "node --experimental-websocket scripts/capture-lab.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
